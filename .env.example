# --- App ---
NODE_ENV=development
APP_ENV=development
PORT=3000
SHOPIFY_APP_URL=http://localhost:3000

# --- Database (local Postgres via `pnpm db:up`) ---
# For production use a managed Postgres (Neon/Supabase/Railway) and set this in host secrets.
DATABASE_URL="postgresql://threeye:threeye_dev@localhost:5432/threeye?schema=public"

# --- Shopify (fill in once you create a Partner account + app) ---
# While MOCK_SHOPIFY=true the app runs on a seeded mock shop with no Shopify creds.
MOCK_SHOPIFY=true
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders
# SHOP_CUSTOM_DOMAIN=

# --- Privacy / hashing (rotate in prod; keep secret; never commit real values) ---
INGEST_SALT=dev-only-insecure-salt-change-me
SESSION_HASH_TTL_HOURS=24

# --- AI conversation (paid feature). mock provider needs no key. ---
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-1

# --- Insight-engine defaults (configurable; see PLANS/v1 open decisions) ---
K_ANONYMITY_MIN=50
DEFAULT_CURRENCY=USD
